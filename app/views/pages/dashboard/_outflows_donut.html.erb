<%# locals: (outflows_data:, period:, accounts: [], account_ids: nil, view_params: {}) %>
<%
  # account_ids is nil when every account is shown. Drill-down links then
  # keep the transactions page's own default, as before.
  selected_account_ids = account_ids || accounts.map { |a| a.id.to_s }
%>
<div id="outflows-donut-section" class="@container">
  <div class="px-4">
    <% if accounts.size > 1 %>
      <div class="flex justify-end mb-4">
        <%= render layout: "pages/dashboard/filter_popover", locals: {
              button_text: account_ids ? t(".filter_accounts", count: account_ids.size) : t(".filter_accounts_all"),
              search_label: t(".search_accounts"),
              apply_text: t(".apply"),
              hidden_fields: view_params.except(:outflows_account_ids)
            } do %>
          <% accounts.sort_by(&:name).each do |account| %>
            <%= render layout: "pages/dashboard/filter_popover_option", locals: {
                  name: "outflows_account_ids[]",
                  value: account.id,
                  checked: selected_account_ids.include?(account.id.to_s),
                  filter_name: account.name
                } do %>
              <span class="text-sm text-primary truncate"><%= account.name %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if outflows_data[:categories].empty? %>
      <p class="text-sm text-secondary py-6 text-center"><%= t(".no_data") %></p>
    <% else %>
    <%# outflows-filter: the live category checkboxes below redraw the donut
        and recompute the total and shares, without a round trip. %>
    <div class="flex flex-col @2xl:flex-row gap-8 items-center"
      data-controller="outflows-filter"
      data-outflows-filter-segments-value="<%= outflows_data[:categories].to_json %>"
      data-outflows-filter-currency-value="<%= outflows_data[:currency] %>"
      data-outflows-filter-locale-value="<%= I18n.locale %>">
      <!-- Donut Chart -->
      <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
        <div class="h-[300px] relative"
          data-controller="donut-chart"
          data-outflows-filter-target="donut"
          data-donut-chart-segments-value="<%= outflows_data[:categories].to_json %>"
          data-donut-chart-segment-opacity-value="0.9"
          data-donut-chart-extended-hover-value="true"
          data-donut-chart-hover-extension-value="3"
          data-donut-chart-enable-click-value="true"
          data-donut-chart-start-date-value="<%= period.date_range.first %>"
          data-donut-chart-end-date-value="<%= period.date_range.last %>"
          data-donut-chart-account-ids-value="<%= Array(account_ids).to_json %>">
          <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

          <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
            <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
              <div class="text-secondary text-sm mb-2">
                <span><%= t("pages.dashboard.outflows_donut.total_outflows") %></span>
              </div>

              <div data-donut-chart-target="amount" data-outflows-filter-target="total" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                <%= format_money Money.new(outflows_data[:total], outflows_data[:currency]) %>
              </div>
            </div>

            <% outflows_data[:categories].each do |category| %>
              <div id="segment_<%= category[:id] %>" class="hidden">
                <div class="flex flex-col gap-2 items-center">
                  <p class="text-sm text-secondary"><%= category[:name] %></p>

                  <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                    <%= outflows_data[:currency_symbol] %><%= number_with_delimiter(category[:amount], delimiter: ",") %>
                  </p>

                  <p class="text-sm text-secondary privacy-sensitive" data-outflows-filter-target="percentage" data-category-id="<%= category[:id] %>"><%= category[:percentage] %>%</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Category List -->
      <div class="w-full @2xl:w-2/3 bg-container-inset rounded-xl p-1 space-y-1 overflow-x-auto">
        <div class="px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
          <div class="flex items-center gap-3 @2xl:w-40">
            <%= tag.input type: "checkbox", checked: true, class: "checkbox checkbox--light",
                  aria: { label: t(".select_all") },
                  data: { outflows_filter_target: "all", action: "change->outflows-filter#toggleAll" } %>
            <p><%= t("pages.dashboard.outflows_donut.categories") %><span class="text-subdued mx-1">&middot;</span><%= outflows_data[:categories].count %></p>
          </div>
          <div class="ml-auto text-right flex items-center gap-6">
            <div class="w-16 @2xl:w-40">
              <p><%= t("pages.dashboard.outflows_donut.value") %></p>
            </div>
            <div class="w-16">
              <p><%= t("pages.dashboard.outflows_donut.weight") %></p>
            </div>
          </div>
        </div>
        <div class="py-3 shadow-border-xs rounded-lg bg-container font-medium text-sm max-w-full">
          <% outflows_data[:categories].each_with_index do |category, idx| %>
            <%
              category_content = capture do
            %>
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="h-7 w-7 flex-shrink-0 group-hover:scale-105 transition-all duration-300 rounded-full flex justify-center items-center"
                  style="
                    background-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    border-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    color: <%= category[:color] %>;">
                  <% if category[:icon] %>
                    <%= icon(category[:icon], color: "current", size: "sm") %>
                  <% else %>
                    <%= render DS::FilledIcon.new(
                      variant: :text,
                      hex_color: category[:color],
                      text: category[:name],
                      size: "sm",
                      rounded: true
                    ) %>
                  <% end %>
                </div>
                <span class="text-sm font-medium text-primary truncate"><%= category[:name] %></span>
              </div>
              <div class="flex items-center gap-4 flex-shrink-0 text-right">
                <span class="text-sm font-medium text-primary whitespace-nowrap privacy-sensitive"><%= format_money Money.new(category[:amount], category[:currency]) %></span>
                <span class="text-sm text-secondary whitespace-nowrap w-10 @2xl:w-15 privacy-sensitive" data-outflows-filter-target="percentage" data-category-id="<%= category[:id] %>"><%= category[:percentage] %>%</span>
              </div>
            <% end %>

            <div class="flex items-center pl-3 transition-opacity" data-outflows-filter-target="row" data-category-id="<%= category[:id] %>">
            <%= tag.input type: "checkbox", value: category[:id], checked: true, class: "checkbox checkbox--light flex-shrink-0",
                  aria: { label: t(".toggle_category", name: category[:name]) },
                  data: { outflows_filter_target: "checkbox", action: "change->outflows-filter#toggle" } %>
            <% if category[:clickable] != false %>
              <%= link_to transactions_path(q: { categories: [category[:filter_value]], start_date: period.date_range.first, end_date: period.date_range.last, account_ids: account_ids }.compact),
                  class: "flex flex-1 min-w-0 items-center justify-between ml-1 mr-3 p-3 rounded-lg cursor-pointer group gap-3",
                  data: {
                    turbo_frame: "_top",
                    turbo_prefetch: false,
                    category_id: category[:id],
                    action: "mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment"
                  } do %>
                <%= category_content %>
              <% end %>
            <% else %>
              <div class="flex flex-1 min-w-0 items-center justify-between ml-1 mr-3 p-3 rounded-lg group gap-3"
                  data-category-id="<%= category[:id] %>"
                  data-action="mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment">
                <%= category_content %>
              </div>
            <% end %>
            </div>
            <% if idx < outflows_data[:categories].size - 1 %>
              <%= render "shared/ruler", classes: "mx-3 @2xl:mx-4" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
</div>
